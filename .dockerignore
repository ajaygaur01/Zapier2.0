# Ignore node_modules
node_modules
**/node_modules

# Ignore Next.js build output
.next
**/.next
apps/frontend/.next
apps/frontend/out

# Ignore git and ide configurations
.git
.github
.vscode
.idea

# Ignore logs
*.log
**/*.log

# Ignore local env files (loaded dynamically or managed via ConfigMaps/Secrets)
.env
**/.env
.env.local
**/.env.local
.env.development
.env.production
